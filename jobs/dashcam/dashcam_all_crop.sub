universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable = /bin/bash
arguments = /path/to/Lane_Detection/benchmark_culane/scripts/dashcam_all.sh /path/to/Lane_Detection/benchmark_culane/vendors/ufldv2/example.mp4 /path/to/Lane_Detection/benchmark_culane/results/adapter_v2/crop_calibration.json
initialdir = /path/to/Lane_Detection/benchmark_culane
output = /path/to/Lane_Detection/benchmark_culane/logs/dashcam/dashcam_all.$(ClusterId).$(ProcId).out
error = /path/to/Lane_Detection/benchmark_culane/logs/dashcam/dashcam_all.$(ClusterId).$(ProcId).err
log = /path/to/Lane_Detection/benchmark_culane/logs/dashcam/dashcam_all.$(ClusterId).log
should_transfer_files = NO
request_GPUs = 1
request_CPUs = 4
request_memory = 16G
request_disk = 8G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
+WantScratchMounted = true
queue 1
