universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable = /bin/bash
arguments = /path/to/Lane_Detection/benchmark_culane/scripts/run_score_robust.sh /path/to/Lane_Detection/benchmark_culane/results/robustness/smoke_20261119T153846Z 10
initialdir = /path/to/Lane_Detection/benchmark_culane
output = /path/to/Lane_Detection/benchmark_culane/logs/robust/score_smoke.$(ClusterId).out
error = /path/to/Lane_Detection/benchmark_culane/logs/robust/score_smoke.$(ClusterId).err
log = /path/to/Lane_Detection/benchmark_culane/logs/robust/score_smoke.$(ClusterId).log
should_transfer_files = NO
request_cpus = 2
request_memory = 4G
request_disk = 1G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
+WantScratchMounted = true
queue 1
