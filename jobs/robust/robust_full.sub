universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable = /bin/bash
arguments = /path/to/Lane_Detection/benchmark_culane/scripts/gpu_entry.sh $(model) robust
environment = "ROBUST_ROOT=/path/to/Lane_Detection/benchmark_culane/results/robustness/full_20261119T154132Z"
initialdir = /path/to/Lane_Detection/benchmark_culane
output = /path/to/Lane_Detection/benchmark_culane/logs/robust/full_$(model).$(ClusterId).out
error = /path/to/Lane_Detection/benchmark_culane/logs/robust/full_$(model).$(ClusterId).err
log = /path/to/Lane_Detection/benchmark_culane/logs/robust/full.$(ClusterId).log
should_transfer_files = NO
request_GPUs = 1
request_CPUs = 4
request_memory = 16G
request_disk = 8G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
+WantScratchMounted = true
queue model in (scnn ufldv2 clrernet)
