# Tracker accuracy on labeled video (CULane test clips), one job per model; predictions = the scored full-test runs.
universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable = /bin/bash
arguments = /path/to/Lane_Detection/benchmark_culane/scripts/run_tracker_culane.sh $(model) $(pred)
initialdir = /path/to/Lane_Detection/benchmark_culane
output = /path/to/Lane_Detection/benchmark_culane/logs/tracker_culane/$(model).$(ClusterId).out
error = /path/to/Lane_Detection/benchmark_culane/logs/tracker_culane/$(model).$(ClusterId).err
log = /path/to/Lane_Detection/benchmark_culane/logs/tracker_culane/tracker.$(ClusterId).log
environment = "OMP_NUM_THREADS=4"
should_transfer_files = NO
request_cpus = 4
request_memory = 6G
request_disk = 8G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
+WantScratchMounted = true
queue model, pred from (
  clrernet, /path/to/Lane_Detection/benchmark_culane/results/clrernet/full/run_20261119T140104Z_<cluster-user>-73864/pred
  scnn, /path/to/Lane_Detection/benchmark_culane/results/scnn/full/coord_output
  ufldv2_notta, /path/to/Lane_Detection/benchmark_culane/results/ufldv2/full_notta/culane_eval_tmp
)
