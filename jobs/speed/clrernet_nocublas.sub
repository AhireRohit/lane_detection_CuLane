universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable = /bin/bash
arguments = /path/to/Lane_Detection/benchmark_culane/scripts/gpu_entry.sh clrernet speed
environment = "CLR_NO_CUBLAS_CFG=1 SPEED_BATCH=run_clrernet_no_cublas_cfg_$(ClusterId)"
initialdir = /path/to/Lane_Detection/benchmark_culane
output = /path/to/Lane_Detection/benchmark_culane/logs/speed/clrernet_nocublas.$(ClusterId).out
error = /path/to/Lane_Detection/benchmark_culane/logs/speed/clrernet_nocublas.$(ClusterId).err
log = /path/to/Lane_Detection/benchmark_culane/logs/speed/clrernet_nocublas.$(ClusterId).log
should_transfer_files = NO
request_GPUs = 1
request_CPUs = 4
request_memory = 16G
request_disk = 4G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
+WantScratchMounted = true
queue 1
