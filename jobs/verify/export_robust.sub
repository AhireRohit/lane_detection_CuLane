# Export the seed-0 corruption fine-tune as a small inference checkpoint for the Hugging Face Space (CPU job).
universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable = /path/to/Lane_Detection/benchmark_culane/.venvs/clrernet/bin/python
arguments = /path/to/Lane_Detection/benchmark_culane/scripts/export_robust_ckpt.py $ENV(SRC) /path/to/Lane_Detection/benchmark_culane/results/export/clrernet_culane_dla34_robust_ft.pth
initialdir = /path/to/Lane_Detection/benchmark_culane
output = /path/to/Lane_Detection/benchmark_culane/logs/export_robust.$(ClusterId).out
error = /path/to/Lane_Detection/benchmark_culane/logs/export_robust.$(ClusterId).err
log = /path/to/Lane_Detection/benchmark_culane/logs/export_robust.$(ClusterId).log
should_transfer_files = NO
request_cpus = 2
request_memory = 8G
request_disk = 2G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
+WantScratchMounted = true
queue 1
