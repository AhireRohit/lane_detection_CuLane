# CPU-only end-to-end test of the Streamlit Community Cloud demo (fresh env, real setup).
universe = docker
docker_image = python:3.10
executable = /bin/bash
arguments = /path/to/Lane_Detection/benchmark_culane/scripts/test_streamlit_demo.sh $ENV(IMG) $ENV(VID)
initialdir = /path/to/Lane_Detection/benchmark_culane
output = /path/to/Lane_Detection/benchmark_culane/logs/test_streamlit_demo.$(ClusterId).out
error = /path/to/Lane_Detection/benchmark_culane/logs/test_streamlit_demo.$(ClusterId).err
log = /path/to/Lane_Detection/benchmark_culane/logs/test_streamlit_demo.$(ClusterId).log
should_transfer_files = NO
request_cpus = 8
request_memory = 24G
request_disk = 10G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
+WantScratchMounted = true
environment = "IMG=$ENV(IMG) VID=$ENV(VID)"
queue 1
