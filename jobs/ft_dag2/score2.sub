universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable = /bin/bash
arguments = /path/to/Lane_Detection/benchmark_culane/scripts/ft2_score.sh /path/to/Lane_Detection/benchmark_culane/results/finetune/clrernet_ft_broad_20261120T010825Z_<cluster-user>-74187 /path/to/Lane_Detection/benchmark_culane/results/finetune/clrernet_ft_control_s1_20261120T010825Z_<cluster-user>-74187 /path/to/Lane_Detection/benchmark_culane/results/finetune/clrernet_ft_control_s2_20261120T010825Z_<cluster-user>-74187 /path/to/Lane_Detection/benchmark_culane/results/finetune/clrernet_ft_corrupt_s1_20261120T010825Z_<cluster-user>-74187 /path/to/Lane_Detection/benchmark_culane/results/finetune/clrernet_ft_corrupt_s2_20261120T010825Z_<cluster-user>-74187
initialdir = /path/to/Lane_Detection/benchmark_culane
output = /path/to/Lane_Detection/benchmark_culane/logs/ft_dag2/score.$(ClusterId).out
error = /path/to/Lane_Detection/benchmark_culane/logs/ft_dag2/score.$(ClusterId).err
log = /path/to/Lane_Detection/benchmark_culane/logs/ft_dag2/ft_dag2.log
environment = "OMP_NUM_THREADS=1"
should_transfer_files = NO
request_cpus = 10
request_memory = 8G
request_disk = 2G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
+WantScratchMounted = true
queue 1
