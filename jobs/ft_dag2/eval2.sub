universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable = /bin/bash
arguments = /path/to/Lane_Detection/benchmark_culane/scripts/ft_eval.sh $(run) $(tag)
initialdir = /path/to/Lane_Detection/benchmark_culane
output = /path/to/Lane_Detection/benchmark_culane/logs/ft_dag2/eval_$(tag).$(ClusterId).out
error = /path/to/Lane_Detection/benchmark_culane/logs/ft_dag2/eval_$(tag).$(ClusterId).err
log = /path/to/Lane_Detection/benchmark_culane/logs/ft_dag2/ft_dag2.log
should_transfer_files = NO
request_GPUs = 1
request_CPUs = 4
request_memory = 16G
request_disk = 8G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
+WantScratchMounted = true
queue 1
