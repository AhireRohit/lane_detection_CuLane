# Streamlit demo app: lane detection on one uploaded image/video. Submitted by app/cluster.py as
#   APP_JOB=<job dir> condor_submit jobs/app/infer.sub
universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable = /bin/bash
arguments = /path/to/Lane_Detection/benchmark_culane/scripts/app_job.sh
initialdir = /path/to/Lane_Detection/benchmark_culane
output = $ENV(APP_JOB)/job.out
error = $ENV(APP_JOB)/job.err
log = $ENV(APP_JOB)/job.log
should_transfer_files = NO
request_GPUs = 1
request_CPUs = 4
request_memory = 16G
request_disk = 4G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
+WantScratchMounted = true
environment = "APP_JOB=$ENV(APP_JOB)"
queue 1
