# Official CULane scoring of each ONNX variant's full-test predictions (after onnx_infer.sub). No GPU.
universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable = /bin/bash
arguments = /path/to/Lane_Detection/benchmark_culane/scripts/score_culane_official.sh onnx_eval/$(variant) /path/to/Lane_Detection/benchmark_culane/results/onnx/$(variant)/pred
initialdir = /path/to/Lane_Detection/benchmark_culane
output = /path/to/Lane_Detection/benchmark_culane/logs/onnx/score_$(variant).$(ClusterId).out
error = /path/to/Lane_Detection/benchmark_culane/logs/onnx/score_$(variant).$(ClusterId).err
log = /path/to/Lane_Detection/benchmark_culane/logs/onnx/onnx.$(ClusterId).log
environment = "OMP_NUM_THREADS=4"
should_transfer_files = NO
request_cpus = 4
request_memory = 4G
request_disk = 2G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
+WantScratchMounted = true
queue variant in (onnx_fp32, int8_all, int8_bbneck)
