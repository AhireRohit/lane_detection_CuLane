# Export CLRerNet to ONNX FP32/INT8, equivalence + writer checks, CPU speed (scripts/onnx_clrernet.py export). No GPU.
universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable = /bin/bash
arguments = /path/to/Lane_Detection/benchmark_culane/scripts/onnx_job.sh export
initialdir = /path/to/Lane_Detection/benchmark_culane
output = /path/to/Lane_Detection/benchmark_culane/logs/onnx/export.$(ClusterId).out
error = /path/to/Lane_Detection/benchmark_culane/logs/onnx/export.$(ClusterId).err
log = /path/to/Lane_Detection/benchmark_culane/logs/onnx/onnx.$(ClusterId).log
environment = "OMP_NUM_THREADS=4"
should_transfer_files = NO
request_cpus = 4
request_memory = 12G
request_disk = 4G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
+WantScratchMounted = true
queue 1
