universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable = /bin/bash
arguments = /path/to/Lane_Detection/benchmark_culane/scripts/gpu_entry.sh clrernet finetune
environment = "FT_CFG=/path/to/Lane_Detection/benchmark_culane/configs_ft/$(cfg).py FT_NAME=$(name) FT_OPTS=$(opts)"
initialdir = /path/to/Lane_Detection/benchmark_culane
output = /path/to/Lane_Detection/benchmark_culane/logs/finetune/ovn_$(name).$(ClusterId).out
error = /path/to/Lane_Detection/benchmark_culane/logs/finetune/ovn_$(name).$(ClusterId).err
log = /path/to/Lane_Detection/benchmark_culane/logs/finetune/overnight.$(ClusterId).log
should_transfer_files = NO
request_GPUs = 1
request_CPUs = 4
request_memory = 24G
request_disk = 8G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
+WantScratchMounted = true
# Overnight 2026-11-20: 2 extra seeds for control and corruption (seed 0 = runs 73992), plus the broad-augmentation arm.
queue cfg, name, opts from (
  clrernet_ft_control, clrernet_ft_control_s1, randomness.seed=1
  clrernet_ft_control, clrernet_ft_control_s2, randomness.seed=2
  clrernet_ft_corrupt, clrernet_ft_corrupt_s1, randomness.seed=1
  clrernet_ft_corrupt, clrernet_ft_corrupt_s2, randomness.seed=2
  clrernet_ft_broad, clrernet_ft_broad, randomness.seed=0
)
