universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-devel
executable = /bin/bash
arguments = /path/to/Lane_Detection/benchmark_culane/scripts/b1_recal_then_ablate.sh $(ClusterId)
initialdir = /path/to/Lane_Detection/benchmark_culane
output = /path/to/Lane_Detection/benchmark_culane/logs/b1_recal/calib_ablate.$(ClusterId).$(ProcId).out
error = /path/to/Lane_Detection/benchmark_culane/logs/b1_recal/calib_ablate.$(ClusterId).$(ProcId).err
log = /path/to/Lane_Detection/benchmark_culane/logs/b1_recal/calib_ablate.$(ClusterId).log
environment = "OMP_NUM_THREADS=4"
should_transfer_files = NO
request_cpus = 4
request_memory = 8G
request_disk = 4G
requirements = UidDomain == "cs.uni-saarland.de"
+WantGPUHomeMounted = true
+WantScratchMounted = true
queue 1
